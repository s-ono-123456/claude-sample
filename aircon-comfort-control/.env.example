# SwitchBot OpenAPI v1.1 認証情報（SwitchBotアプリのプロフィール > 詳細設定 > 開発者向けオプション で取得）
SWITCHBOT_TOKEN=your-token
SWITCHBOT_SECRET=your-secret

# 操作対象デバイスID
SWITCHBOT_SENSOR_DEVICE_ID=your-meter-device-id
SWITCHBOT_AIRCON_DEVICE_ID=your-aircon-virtual-device-id

# 状態保存用S3
S3_BUCKET=your-state-bucket
S3_STATE_KEY=state.json

# 快適性判定（不快指数）
DI_TARGET_MIN=60
DI_TARGET_MAX=70
DI_DEADBAND=2
COOLDOWN_MINUTES=15

# 設定温度の調整範囲
TEMP_STEP=1
TEMP_MIN=20
TEMP_MAX=28
INITIAL_TEMP=26

# エアコン運転モード: 1=自動 2=冷房 3=除湿 4=送風 5=暖房
AIRCON_MODE=2
# 風量: 1=自動 2=弱 3=中 4=強
AIRCON_FAN_SPEED=1
